# Copier en .env et adapter. Ne jamais committer le fichier .env.
DATABASE_URL="postgresql://postgres:motdepasse@localhost:5432/anansi_edu"
JWT_SECRET=changez-moi
PORT=3000

# --- Notifications e-mail des candidatures ---------------------------------
# Sans SMTP_HOST, SMTP_PORT et SMTP_FROM, l'envoi échoue proprement : la
# notification passe au statut ECHEC (relançable par le personnel) et la
# candidature est tout de même enregistrée.
SMTP_HOST=smtp.example.org
SMTP_PORT=587
# Expéditeur affiché, ex. "Admissions IUC <admissions@example.org>"
SMTP_FROM=
# true/false ; par défaut true uniquement pour le port 465
SMTP_SECURE=false
# Facultatifs, mais à renseigner ensemble (authentification SMTP)
SMTP_USER=
SMTP_PASSWORD=
# URL publique du site (sans « / » final) : sert au lien /suivi des courriels
FRONTEND_PUBLIC_URL=http://localhost:5173
# Temps maximal (ms) qu'une requête attend l'envoi du courriel avant de répondre
# (l'envoi se termine alors en arrière-plan). Défaut : 3000
# CANDIDATURE_EMAIL_WAIT_MS=3000
