generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Tenant {
  id                String            @id @default(uuid())
  nom               String
  slug              String            @unique
  pays              String
  ville             String
  createdAt         DateTime          @default(now())
  users             User[]
  ecoles            Ecole[]
  anneesAcademiques AnneeAcademique[]
  candidatures      Candidature[]
  etudiants         Etudiant[]
  enseignants       Enseignant[]
  campus            Campus[]
}

model User {
  id                    String   @id @default(uuid())
  tenantId              String
  nom                   String
  prenom                String
  email                 String   @unique
  telephone             String?
  motDePasseHash        String
  role                  Role
  statut                Statut   @default(ACTIF)
  // true tant que l'utilisateur garde un mot de passe temporaire
  doitChangerMotDePasse Boolean  @default(false)
  createdAt             DateTime @default(now())

  tenant      Tenant                  @relation(fields: [tenantId], references: [id])
  etudiant    Etudiant?
  enseignant  Enseignant?
  historiques HistoriqueCandidature[]
}

enum Role {
  ADMIN
  SCOLARITE
  ENSEIGNANT
  ETUDIANT
}

enum Statut {
  ACTIF
  INACTIF
  SUSPENDU
}

model Ecole {
  id          String  @id @default(uuid())
  tenantId    String
  nom         String
  code        String
  description String?
  campusId    String?

  tenant   Tenant    @relation(fields: [tenantId], references: [id])
  // Restrict : un campus avec des écoles rattachées ne peut pas être supprimé
  campus   Campus?   @relation(fields: [campusId], references: [id], onDelete: Restrict)
  filieres Filiere[]
}

enum StatutDonnees {
  CONFIRME
  A_CONFIRMER
}

enum ModeAdmission {
  CONCOURS
  ETUDE_DOSSIER
  ENTRETIEN
}

model Campus {
  id            String        @id @default(uuid())
  tenantId      String
  nom           String
  code          String?
  adresse       String?
  description   String?
  statutDonnees StatutDonnees @default(A_CONFIRMER)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  tenant        Tenant        @relation(fields: [tenantId], references: [id])
  ecoles        Ecole[]
  salles        Salle[]

  @@unique([tenantId, nom])
}

model Filiere {
  id                       String         @id @default(uuid())
  ecoleId                  String
  nom                      String
  code                     String
  cycle                    Cycle
  // Optionnels : une filière peut être créée au minimum puis complétée
  regime                   Regime?
  langue                   Langue?
  dureeAnnees              Int?
  tutelle                  String?
  credits                  Int?
  niveauEntree             String?
  diplomeRequis            String?
  modeAdmission            ModeAdmission?
  fraisCandidatureNational Decimal?
  fraisCandidatureEtranger Decimal?
  piecesRequises           String[]       @default([])
  statutDonnees            StatutDonnees  @default(A_CONFIRMER)

  ecole        Ecole         @relation(fields: [ecoleId], references: [id])
  niveaux      Niveau[]
  candidatures Candidature[]
}

enum Cycle {
  BTS
  HND
  LICENCE
  MASTER
  INGENIEUR
  BSC
  BBA
  BENG
}

enum Regime {
  LMD
  ANGLO_SAXON
  NATIONAL
}

enum Langue {
  FR
  EN
  FR_EN
}

model Niveau {
  id        String @id @default(uuid())
  filiereId String
  nom       String
  code      String
  ordre     Int

  filiere      Filiere       @relation(fields: [filiereId], references: [id])
  matieres     Matiere[]
  inscriptions Inscription[]
}

model AnneeAcademique {
  id        String   @id @default(uuid())
  tenantId  String
  libelle   String
  dateDebut DateTime
  dateFin   DateTime
  active    Boolean  @default(false)

  tenant       Tenant        @relation(fields: [tenantId], references: [id])
  matieres     Matiere[]
  inscriptions Inscription[]
  candidatures Candidature[]
  affectations Affectation[]
}

model Matiere {
  id                String @id @default(uuid())
  niveauId          String
  anneeAcademiqueId String
  nom               String
  code              String
  credits           Int    @default(0)
  heuresCm          Int    @default(0)
  heuresTd          Int    @default(0)
  heuresTp          Int    @default(0)
  coefficient       Float  @default(1)

  niveau          Niveau          @relation(fields: [niveauId], references: [id])
  anneeAcademique AnneeAcademique @relation(fields: [anneeAcademiqueId], references: [id])
  affectations    Affectation[]
  evaluations     Evaluation[]
  seances         SeanceMatiere[]
}

model Enseignant {
  id         String         @id @default(uuid())
  userId     String         @unique
  tenantId   String
  type       TypeEnseignant
  specialite String?
  cvUrl      String?

  user         User          @relation(fields: [userId], references: [id])
  tenant       Tenant        @relation(fields: [tenantId], references: [id])
  affectations Affectation[]
  seances      Seance[]
}

enum TypeEnseignant {
  PERMANENT
  VACATAIRE
}

model Affectation {
  id                String @id @default(uuid())
  enseignantId      String
  matiereId         String
  anneeAcademiqueId String
  heuresPrevues     Int    @default(0)
  heuresEffectuees  Int    @default(0)

  enseignant      Enseignant      @relation(fields: [enseignantId], references: [id])
  matiere         Matiere         @relation(fields: [matiereId], references: [id])
  anneeAcademique AnneeAcademique @relation(fields: [anneeAcademiqueId], references: [id])

  @@unique([enseignantId, matiereId])
}

model Etudiant {
  id            String   @id @default(uuid())
  userId        String   @unique
  tenantId      String
  matricule     String   @unique
  dateNaissance DateTime
  lieuNaissance String
  nationalite   String
  photoUrl      String?
  candidatureId String?  @unique
  // Matricule institutionnel (import / affichage), jamais généré : IUC + AA + E + 7 chiffres
  matriculeIuc  String?  @unique

  user         User          @relation(fields: [userId], references: [id])
  tenant       Tenant        @relation(fields: [tenantId], references: [id])
  candidature  Candidature?  @relation(fields: [candidatureId], references: [id])
  inscriptions Inscription[]
}

model Inscription {
  id                String            @id @default(uuid())
  etudiantId        String
  niveauId          String
  anneeAcademiqueId String
  statut            StatutInscription @default(EN_ATTENTE)
  dateInscription   DateTime          @default(now())
  fraisPayes        Boolean           @default(false)
  createdBy         String

  etudiant        Etudiant        @relation(fields: [etudiantId], references: [id])
  niveau          Niveau          @relation(fields: [niveauId], references: [id])
  anneeAcademique AnneeAcademique @relation(fields: [anneeAcademiqueId], references: [id])
  notes           Note[]

  @@unique([etudiantId, anneeAcademiqueId])
}

enum StatutInscription {
  EN_ATTENTE
  VALIDE
  REJETE
  SUSPENDU
}

model Candidature {
  id                String            @id @default(uuid())
  tenantId          String
  nom               String
  prenom            String
  email             String
  telephone         String?
  dateNaissance     DateTime
  lieuNaissance     String
  nationalite       String
  filiereId         String
  anneeAcademiqueId String
  statut            StatutCandidature @default(SOUMIS)
  numeroDossier     String            @unique
  createdAt         DateTime          @default(now())

  tenant          Tenant                         @relation(fields: [tenantId], references: [id])
  filiere         Filiere                        @relation(fields: [filiereId], references: [id])
  anneeAcademique AnneeAcademique                @relation(fields: [anneeAcademiqueId], references: [id])
  documents       DocumentCandidature[]
  historiques     HistoriqueCandidature[]
  notifications   NotificationCandidatureEmail[]
  etudiant        Etudiant?
}

enum StatutCandidature {
  SOUMIS
  INCOMPLET
  EN_EXAMEN
  ACCEPTE
  REJETE
}

model DocumentCandidature {
  id            String       @id @default(uuid())
  candidatureId String
  typeDocument  TypeDocument
  nomFichier    String
  urlFichier    String
  valide        Boolean      @default(false)
  commentaire   String?

  candidature Candidature @relation(fields: [candidatureId], references: [id])
}

enum TypeDocument {
  CNI
  DIPLOME
  RELEVE_NOTES
  PHOTO
  AUTRE
}

model HistoriqueCandidature {
  id            String   @id @default(uuid())
  candidatureId String
  userId        String
  action        String
  commentaire   String?
  createdAt     DateTime @default(now())

  candidature Candidature @relation(fields: [candidatureId], references: [id])
  user        User        @relation(fields: [userId], references: [id])
}

enum StatutNotificationEmail {
  EN_ATTENTE
  EN_COURS
  ENVOYEE
  ECHEC
}

enum TypeNotificationCandidature {
  RECEPTION
  CHANGEMENT_STATUT
}

model NotificationCandidatureEmail {
  id             String                      @id @default(uuid())
  candidatureId  String
  type           TypeNotificationCandidature
  destinataire   String
  sujet          String
  contenu        String                      @db.Text
  statut         StatutNotificationEmail     @default(EN_ATTENTE)
  tentatives     Int                         @default(0)
  derniereErreur String?                     @db.Text
  envoyeLe       DateTime?
  createdAt      DateTime                    @default(now())

  candidature Candidature @relation(fields: [candidatureId], references: [id], onDelete: Cascade)

  @@index([candidatureId, createdAt])
  @@index([statut, createdAt])
}

enum TypeEvaluation {
  DEVOIR
  TP
  PROJET
  EXAMEN
  AUTRE
}

enum StatutEvaluation {
  BROUILLON
  PUBLIEE
}

enum EtatNote {
  NOTEE
  ABSENT
  DISPENSE
}

// Épreuve nommée d'une matière ; creePar / publiePar : identifiants d'utilisateur
model Evaluation {
  id          String           @id @default(uuid())
  matiereId   String
  nom         String
  type        TypeEvaluation
  coefficient Decimal          @default(1) @db.Decimal(5, 2)
  bareme      Decimal          @default(20) @db.Decimal(5, 2)
  date        DateTime?
  statut      StatutEvaluation @default(BROUILLON)
  publieLe    DateTime?
  publiePar   String?
  creePar     String
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  matiere    Matiere                @relation(fields: [matiereId], references: [id])
  notes      Note[]
  historique EvaluationHistorique[]

  @@unique([matiereId, nom])
}

// Note d'un inscrit à une évaluation ; updatedAt sert au contrôle de concurrence
model Note {
  id            String   @id @default(uuid())
  evaluationId  String
  inscriptionId String
  valeur        Decimal? @db.Decimal(6, 2)
  etat          EtatNote @default(NOTEE)
  commentaire   String?
  saisiePar     String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  evaluation  Evaluation       @relation(fields: [evaluationId], references: [id], onDelete: Cascade)
  inscription Inscription      @relation(fields: [inscriptionId], references: [id])
  historiques NoteHistorique[]

  @@unique([evaluationId, inscriptionId])
}

// Journal des corrections d'une note (motif obligatoire), calqué sur HistoriqueCandidature
model NoteHistorique {
  id             String   @id @default(uuid())
  noteId         String
  ancienneValeur Decimal? @db.Decimal(6, 2)
  nouvelleValeur Decimal? @db.Decimal(6, 2)
  ancienEtat     EtatNote
  nouvelEtat     EtatNote
  motif          String
  modifiePar     String
  date           DateTime @default(now())

  note Note @relation(fields: [noteId], references: [id], onDelete: Cascade)

  @@index([noteId, date])
}

enum ActionPublication {
  PUBLICATION
  DEPUBLICATION
}

// Journal des publications et dépublications d'une évaluation (motif obligatoire à la dépublication)
model EvaluationHistorique {
  id           String            @id @default(uuid())
  evaluationId String
  action       ActionPublication
  motif        String?
  userId       String
  date         DateTime          @default(now())

  evaluation Evaluation @relation(fields: [evaluationId], references: [id], onDelete: Cascade)

  @@index([evaluationId, date])
}

// ---- Emploi du temps ----

enum TypeSeance {
  CM
  TD
  TP
  EXAMEN
  RESIT
}

// Jour ou Soir : distinct de Regime (régime académique de la filière)
enum Rythme {
  JOUR
  SOIR
}

enum StatutSeance {
  BROUILLON
  PUBLIEE
}

// Salle d'un campus (code unique par campus, ex. « BL100 »)
model Salle {
  id       String  @id @default(uuid())
  campusId String
  code     String
  nom      String?
  // Texte libre pour l'instant (amphi, labo info...) : la liste n'est pas figée
  type     String?
  capacite Int?

  campus  Campus   @relation(fields: [campusId], references: [id])
  seances Seance[]

  @@unique([campusId, code])
}

// Séance datée (une ligne par occurrence). Le jour de la semaine se déduit de la date.
// Les heures sont des minutes depuis minuit (480 = 08:00), fin exclue.
model Seance {
  id              String       @id @default(uuid())
  date            DateTime     @db.Date
  heureDebut      Int
  heureFin        Int
  type            TypeSeance
  enseignantId    String?
  salleId         String?
  rythme          Rythme       @default(JOUR)
  statut          StatutSeance @default(BROUILLON)
  annuleLe        DateTime?
  motifAnnulation String?
  // Occurrences issues d'une même création en lot
  serieId         String?
  creePar         String
  // Identifiant dans un système source (futur import b2i), jamais utilisé par l'application
  sourceExterneId String?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  enseignant Enseignant?     @relation(fields: [enseignantId], references: [id], onDelete: Restrict)
  salle      Salle?          @relation(fields: [salleId], references: [id], onDelete: Restrict)
  matieres   SeanceMatiere[]

  @@index([date])
  @@index([enseignantId, date])
  @@index([salleId, date])
  @@index([serieId])
}

// Matières d'une séance (N-N) : le niveau et l'année en découlent. Un cours commun
// à plusieurs filières est une seule séance liée à plusieurs matières.
model SeanceMatiere {
  seanceId  String
  matiereId String

  seance  Seance  @relation(fields: [seanceId], references: [id], onDelete: Cascade)
  matiere Matiere @relation(fields: [matiereId], references: [id])

  @@id([seanceId, matiereId])
  @@index([matiereId])
}
